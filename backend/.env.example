# Copy to backend/.env and fill in. Never commit the real .env.

# Optional: Claude forecasts are disabled when empty.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
FORECAST_MONTHLY_BUDGET_USD=10

# Optional: Finnhub quotes (yfinance is used as fallback).
FINNHUB_API_KEY=

DATABASE_URL=sqlite:///./stockwallet.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
